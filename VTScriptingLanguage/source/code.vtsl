//debug:t
define players: MultiplayerSpawn = 1..5;
arr playerLandTimers: 5;
arr lastPlayerStates: 5;

fn onPlayerLand(playerIndex) {
	print("Player landed!");
}

fn loop() {
	for (let i = 0; i < 5; i += 1) {
		playerLandTimers[i] = playerLandTimers[i] + 1;

		if(players[i].SCC_Landed()) {
			if (lastPlayerStates[i] == 0) {
				if (playerLandTimers[i] > 10) {
					onPlayerLand(i);
					playerLandTimers[i] = 0;
				}
			}
			lastPlayerStates[i] = 1;
		} else {
			lastPlayerStates[i] = 0;
		}
	}
}