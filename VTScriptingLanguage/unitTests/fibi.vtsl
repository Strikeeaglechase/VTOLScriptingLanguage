define targets: Unit = (1, 2, 10..17, 5, 18..106);
let a = 1;
let b = 1;
let c = 0; 

fn doPartialFib(a2, b2, c2) {
	targets[c2].DestroySelf();

	return a2 + b2;
}

while (c < 100) {
	//c = doPartialFib(a, b, c);
	targets[c].DestroySelf();
	c = a + b;
	a = b;
	b = c;
}