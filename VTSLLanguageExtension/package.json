{
	"name": "vtsl-lsp",
	"description": "Adds LSP support for VT Scripting Language (VTSL)",
	"author": "Strikeeaglechase",
	"license": "MIT",
	"version": "1.0.7",
	"publisher": "Strikeeaglechase",
	"repository": {
		"type": "git",
		"url": "https://github.com/Strikeeaglechase/VTOLScriptingLanguage"
	},
	"categories": [],
	"engines": {
		"vscode": "^1.75.0"
	},
	"activationEvents": [
		"onLanguage:vtsl"
	],
	"main": "./client/out/extension",
	"contributes": {
		"languages": [
			{
				"id": "vtsl",
				"aliases": [
					"VT Scripting Language",
					"vtsl"
				],
				"extensions": [
					".vtsl"
				],
				"icon": {
					"dark": "./vt.png",
					"light": "./vt.png"
				},
				"configuration": "./language-configuration.json"
			}
		]
	},
	"scripts": {},
	"devDependencies": {
		"@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/mocha": "^10.0.6",
		"@types/node": "^20",
		"eslint": "^9.13.0",
		"mocha": "^10.3.0",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.16.0"
	}
}